# Template only. The SDK does NOT read .env files (no dotenv) — it reads
# real environment variables. So you must load this into your shell yourself:
#     set -a; source .env; set +a
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#
# These env vars are how you RUN a bot / pass credentials (password lives
# only here, never in .daoubot/profile.json). The profile is a separate
# CLI-only session cache. Precedence: explicit arg > env (these) > profile.

# Your DaouOffice tenant URL
DAOU_BASE_URL=https://yourcompany.daouoffice.com

# Numeric tenant company id. Find it with:  daoubot discover
DAOU_COMPANY_ID=11000000000

# The dedicated bot account issued by your DaouOffice administrator
DAOU_LOGIN_ID=my-bot
DAOU_PASSWORD=change-me

# --- Only for examples/bot-assistant (LLM is NOT part of the SDK) ---
# LLM_BASE_URL=https://your-openai-compatible-gateway/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
