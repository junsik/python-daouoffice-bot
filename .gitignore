# .gitignore for daouoffice-bot

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Tool caches / coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual Env
.venv/
venv/

# Captured traffic (may contain tokens)
*.saz

# Secrets
.env
*.pem
config.local.py
config.json
credentials.json
tokens.json

# Saved CLI session/profile (contains session token)
.daoubot/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
opencode.json

# Bot runtime output (e.g. examples/bot-room-saver writes room-chat.jsonl)
*.jsonl

# scrape-kit plugin runtime (dev tooling, not part of the project)
.scrape-kit/

# .claude/ is local dev config (project skills for developing THIS repo,
# settings, scrape-kit). The distributable skill lives in skills/.
.claude/
