[Unit]
Description=DaouOffice Messenger Bot
After=network.target

[Service]
Type=simple
User=your-user
WorkingDirectory=/path/to/daouoffice-bot
# Connection settings (see README). Prefer an EnvironmentFile over inline values.
EnvironmentFile=/etc/daoubot.env
ExecStart=/path/to/daouoffice-bot/.venv/bin/daoubot start
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# View logs:  journalctl -u daou-bot -f

[Install]
WantedBy=multi-user.target
